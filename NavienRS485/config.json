{
  "name": "Navien Wallpad Controller with RS485(EW11)",
  "version": "1.1.0",
  "slug": "navien_wallpad",
  "description": "Navien Wallpad Controller for Homeassistant (EW11 MQTT)",
  "arch": ["armhf", "armv7", "aarch64", "amd64", "i386"],
