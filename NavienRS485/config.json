      "server": "192.168.10.234",
      "port": 1883,
      "username": "mqtt",
      "password": ""
    },
    "Advanced": {
      "max_retry": 3,
      "retry_interval": 0.5
    }
  },
  "schema": {
    "MQTT": {
      "server": "str",
      "port": "port",
      "username": "str?",
      "password": "password?"
    },
    "Advanced": {
      "max_retry": "int(0,10)",
      "retry_interval": "float(0.1,5)"
    }
  }
}
